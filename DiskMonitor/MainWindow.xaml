<Window x:Class="DiskMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskMonitor - 디스크 자동 정리"
        Width="720" Height="560"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 폴더 경로 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="감시 폴더 경로" Style="{StaticResource LabelStyle}"/>
            <TextBox Grid.Column="1" x:Name="FolderPathBox"
                     VerticalContentAlignment="Center" Padding="6,4"/>
            <Button Grid.Column="2" Content="찾아보기..." Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="BrowseFolder_Click"/>
        </Grid>

        <!-- 모니터링 주기 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="모니터링 주기(분)" Style="{StaticResource LabelStyle}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="IntervalMinutesBox" Width="100"
                         VerticalContentAlignment="Center" Padding="6,4"/>
                <TextBlock Text="(1 ~ 1440 사이 정수)" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
            </StackPanel>
        </Grid>

        <!-- 한도 종류 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="한도 기준" Style="{StaticResource LabelStyle}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="UsedPercentRadio" Content="사용률(%) 이상이면 삭제"
                             IsChecked="True" GroupName="ThresholdKind"
                             VerticalAlignment="Center" Margin="0,0,16,0"
                             Checked="ThresholdKind_Changed"/>
                <RadioButton x:Name="FreeMbRadio" Content="남은 공간(MB) 미만이면 삭제"
                             GroupName="ThresholdKind"
                             VerticalAlignment="Center"
                             Checked="ThresholdKind_Changed"/>
            </StackPanel>
        </Grid>

        <!-- 한도 값 -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="ThresholdLabel"
                       Text="한도 값(%)" Style="{StaticResource LabelStyle}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="ThresholdValueBox" Width="120"
                         VerticalContentAlignment="Center" Padding="6,4"/>
                <TextBlock x:Name="ThresholdHint" Text="예: 90 = 사용률 90% 이상일 때 1개 삭제"
                           Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
            </StackPanel>
        </Grid>

        <!-- 실행 ON/OFF -->
        <Grid Grid.Row="4" Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="실행" Style="{StaticResource LabelStyle}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="OnOffToggle" Width="76" Height="30"
                              Content="OFF" Click="OnOffToggle_Click"/>
                <TextBlock x:Name="StatusText" Text="중지됨" Margin="14,0,0,0"
                           VerticalAlignment="Center" Foreground="DarkRed" FontWeight="SemiBold"/>
            </StackPanel>
            <Button Grid.Column="2" Content="지금 한 번 검사"
                    Style="{StaticResource PrimaryButton}"
                    Click="RunOnce_Click"/>
        </Grid>

        <!-- 현재 상태 -->
        <Border Grid.Row="5" Background="#F5F7FA" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="DriveSummaryText" Text="드라이브 정보를 확인하려면 경로를 입력하세요." />
                <TextBlock x:Name="NextRunText" Text="" Margin="0,4,0,0" Foreground="Gray"/>
            </StackPanel>
        </Border>

        <!-- 로그 -->
        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="로그" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="로그 비우기" Click="ClearLog_Click" Padding="10,2"/>
            </Grid>
            <TextBox Grid.Row="1" x:Name="LogBox"
                     Margin="0,6,0,0"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     Background="#0F111A"
                     Foreground="#E6E6E6"
                     Padding="8"/>
        </Grid>

        <!-- 하단 버튼 -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="설정 저장" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="SaveSettings_Click"/>
        </StackPanel>
    </Grid>
</Window>
