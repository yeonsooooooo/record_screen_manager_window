<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="DiskMonitor"
           Manufacturer="DiskMonitor"
           Version="1.0.0.0"
           UpgradeCode="3F4D5E2A-9B8E-4C2C-B3D1-2F3F0F8E9A11"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="이미 더 최신 버전이 설치되어 있습니다." />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DiskMonitor" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="DiskMonitor" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="DiskMonitor" Level="1">
      <Component Id="MainExe" Directory="INSTALLFOLDER" Guid="{4A1F2C7D-5E63-4B0B-8F91-C2D3E4F50611}">
        <File Id="DiskMonitorExe"
              Source="$(var.PublishDir)\DiskMonitor.exe"
              KeyPath="yes" />
      </Component>

      <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="{8B5C2A14-9F4D-4A12-B6A3-EF1E1B2C3D4E}">
        <Shortcut Id="AppStartMenuShortcut"
                  Name="DiskMonitor"
                  Description="디스크 자동 정리"
                  Target="[INSTALLFOLDER]DiskMonitor.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\DiskMonitor" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
