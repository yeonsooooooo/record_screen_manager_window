<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>DiskMonitorSetup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>PublishDir=$(MSBuildThisFileDirectory)..\DiskMonitor\bin\Release\net8.0-windows\win-x64\publish</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Product.wxs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.5" />
  </ItemGroup>
</Project>
